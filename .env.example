# Everything prefixed with VITE_ is compiled into the public JavaScript bundle.
# Never put secrets or unrestricted paid RPC keys here — use domain-restricted keys.

# "mainnet" (Base → Solana mainnet) or "testnet" (Base Sepolia → Solana devnet).
VITE_BRIDGE_ENV=mainnet

# Optional: a browser-friendly Base RPC, tried before the public defaults for all reads.
# VITE_BASE_RPC_URL=https://your-base-rpc.example

# Optional: an archive-capable Base RPC for historical eth_call (proof generation).
# Defaults to VITE_BASE_RPC_URL, then https://mainnet.base.org.
# VITE_BASE_ARCHIVE_RPC_URL=https://your-base-archive-rpc.example

# Optional: a browser-friendly Solana RPC, tried before the public defaults.
# VITE_SOLANA_RPC_URL=https://your-solana-rpc.example
